---
import { Image } from "astro:assets";
import { css } from "styled-system/css";
import type { ImageSource } from "../../types/config";
import { url } from "../../utils/url-utils";

type ImageLayout = "constrained" | "fixed" | "full-width" | "none";

interface Props {
  id?: string;
  src: ImageSource;
  class?: string;
  alt?: string;
  position?: string;
  layout?: ImageLayout;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
}

const {
  id,
  src,
  alt = "",
  position = "center",
  layout,
  widths,
  sizes,
  width,
  height,
} = Astro.props;
const className = Astro.props.class;

const isPassthrough = typeof src === "string";
const isPublic = isPassthrough && src.startsWith("/") && !src.startsWith("//");
const isRemote = isPassthrough && /^https:\/\//i.test(src);

if (isPassthrough && !isPublic && !isRemote) {
  throw new Error(
    `Unsupported image source: ${src}. Import local images or use HTTPS/public URLs.`,
  );
}

const passthroughSrc = isPublic ? url(src) : isPassthrough ? src : undefined;
const passthroughWidth = width ?? 1200;
const passthroughHeight = height ?? 600;

const wrapperClass = css({
  position: "relative",
  overflow: "hidden",
});
const overlayClass = css({
  pointerEvents: "none",
  position: "absolute",
  inset: "0",
  transitionProperty:
    "color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter, -webkit-backdrop-filter",
  transitionDuration: "150ms",
  transitionTimingFunction: "cubic-bezier(0.4, 0, 0.2, 1)",
  _dark: {
    backgroundColor: "rgb(0 0 0 / 0.1)",
  },
});
const imageClass = css({
  height: "100%",
  width: "100%",
  objectFit: "cover",
});
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, wrapperClass]}>
    <div class={overlayClass}></div>
    {!isPassthrough && <Image
      src={src}
      alt={alt}
      layout={layout}
      widths={widths}
      sizes={sizes}
      width={width}
      height={height}
      class={imageClass}
      style={imageStyle}
    />}
    {passthroughSrc && <Image
      src={passthroughSrc}
      alt={alt}
      layout="none"
      width={passthroughWidth}
      height={passthroughHeight}
      class={imageClass}
      style={imageStyle}
    />}
</div>
