---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { css } from "styled-system/css";
import { url } from "../../utils/url-utils";

interface Props {
  page: Page;
  class?: string;
  style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
  count += 2;
  l--;
  r++;
}
while (0 < l - 1 && count < VISIBLE) {
  count++;
  l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
  count++;
  r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
  if (p === 1) return "/";
  return `/${p}/`;
};

const paginationClass = css({
  display: "flex",
  flexDirection: "row",
  justifyContent: "center",
  gap: "0.75rem",
});

const navigationButtonClass = css({
  height: "2.75rem",
  width: "2.75rem",
  overflow: "hidden",
  borderRadius: "0.5rem",
  color: "var(--primary)",
});

const navigationIconClass = css({
  fontSize: "1.75rem",
});

const pageListClass = css({
  display: "flex",
  flexDirection: "row",
  alignItems: "center",
  borderRadius: "0.5rem",
  backgroundColor: "var(--card-bg)",
  fontWeight: "700",
  color: "#404040",
  _dark: {
    color: "#d4d4d4",
  },
});

const ellipsisClass = css({
  marginLeft: "0.25rem",
  marginRight: "0.25rem",
});

const currentPageClass = css({
  display: "flex",
  height: "2.75rem",
  width: "2.75rem",
  alignItems: "center",
  justifyContent: "center",
  borderRadius: "0.5rem",
  backgroundColor: "var(--primary)",
  fontWeight: "700",
  color: "#ffffff",
  _dark: {
    color: "rgb(0 0 0 / 0.7)",
  },
});

const pageLinkClass = css({
  height: "2.75rem",
  width: "2.75rem",
  overflow: "hidden",
  borderRadius: "0.5rem",
  _active: {
    transform: "scale(0.85)",
  },
});
---

<div class:list={[className, paginationClass]} style={style}>
    {page.url.prev
        ? <a href={page.url.prev} aria-label="Previous Page" class:list={["btn-card", navigationButtonClass]}>
            <Icon name="material-symbols:chevron-left-rounded" class={navigationIconClass}></Icon>
        </a>
        : <span aria-hidden="true" class:list={["btn-card", navigationButtonClass, "disabled"]}>
            <Icon name="material-symbols:chevron-left-rounded" class={navigationIconClass}></Icon>
        </span>
    }
    <div class={pageListClass}>
        {pages.map((p) => {
            if (p == HIDDEN)
                return <Icon name="material-symbols:more-horiz" class={ellipsisClass}/>;
            if (p == page.currentPage)
                return <div aria-current="page" class={currentPageClass}>
                    {p}
                </div>
            return <a href={url(getPageUrl(p))} aria-label={`Page ${p}`}
                class:list={["btn-card", pageLinkClass]}
            >{p}</a>
        })}
    </div>
    {page.url.next
        ? <a href={page.url.next} aria-label="Next Page" class:list={["btn-card", navigationButtonClass]}>
            <Icon name="material-symbols:chevron-right-rounded" class={navigationIconClass}></Icon>
        </a>
        : <span aria-hidden="true" class:list={["btn-card", navigationButtonClass, "disabled"]}>
            <Icon name="material-symbols:chevron-right-rounded" class={navigationIconClass}></Icon>
        </span>
    }
</div>
