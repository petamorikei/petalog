---
import { Icon } from "astro-icon/components";
import { css } from "styled-system/css";

const wrapperClass = css({
  pointerEvents: "none",
  position: "absolute",
  top: "0",
  right: "0",
  display: "none",
  height: "3.75rem",
  width: "3.75rem",
  lg: {
    display: "block",
  },
});

const backToTopClass = css({
  pointerEvents: "auto",
  position: "fixed",
  bottom: "10rem",
  display: "flex",
  alignItems: "center",
  overflow: "hidden",
  cursor: "pointer",
  border: "none",
  borderRadius: "1rem",
  color: "var(--primary)",
  fontSize: "2.25rem",
  fontWeight: "700",
  opacity: "1",
  transform: "translateX(5rem)",
  transitionProperty:
    "color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter, -webkit-backdrop-filter",
  transitionDuration: "150ms",
  transitionTimingFunction: "cubic-bezier(0.4, 0, 0.2, 1)",
  "& i": {
    fontSize: "1.75rem",
  },
  "&.hide": {
    pointerEvents: "none",
    opacity: "0",
    transform: "translateX(5rem) scale(0.9)",
  },
  _active: {
    transform: "translateX(5rem) scale(0.9)",
  },
});

const buttonClass = css({
  height: "3.75rem",
  width: "3.75rem",
});

const iconClass = css({
  marginRight: "auto",
  marginLeft: "auto",
});
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class:list={["back-to-top-wrapper", wrapperClass]}>
    <div id="back-to-top-btn" inert class:list={["back-to-top-btn", "hide", backToTopClass]}>
        <button type="button" aria-label="Back to Top" class:list={["btn-card", buttonClass]} onclick="backToTop()">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class={iconClass}></Icon>
        </button>
    </div>
</div>

<script is:raw is:inline>
window.backToTop = () => {
    window.scroll({ top: 0, behavior: 'smooth' });
};
</script>
