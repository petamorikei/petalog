---
import { render } from "astro:content";
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { css } from "styled-system/css";
import { licenseConfig } from "@/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const imageBasePath = entry.filePath
	? getDir(entry.filePath).replace(/^src\//, "")
	: path.join("content/posts/", getDir(entry.id));

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};

const transitionClass = css({
	transitionProperty:
		"color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter, -webkit-backdrop-filter",
	transitionTimingFunction: "cubic-bezier(0.4, 0, 0.2, 1)",
	transitionDuration: "150ms",
});
const postOuterClass = css({
	display: "flex",
	width: "100%",
	borderRadius: "var(--radius-large)",
	overflow: "hidden",
	position: "relative",
	marginBottom: "1rem",
});
const postContainerClass = css({
	zIndex: "10",
	paddingLeft: { base: "1.5rem", md: "2.25rem" },
	paddingRight: { base: "1.5rem", md: "2.25rem" },
	paddingTop: "1.5rem",
	paddingBottom: "1rem",
	position: "relative",
	width: "100%",
});
const statsClass = css({
	display: "flex",
	flexDirection: "row",
	color: { base: "rgb(0 0 0 / 0.3)", _dark: "rgb(255 255 255 / 0.3)" },
	gap: "1.25rem",
	marginBottom: "0.75rem",
});
const statClass = css({
	display: "flex",
	flexDirection: "row",
	alignItems: "center",
});
const statIconClass = css({
	height: "1.5rem",
	width: "1.5rem",
	borderRadius: "0.375rem",
	backgroundColor: {
		base: "rgb(0 0 0 / 0.05)",
		_dark: "rgb(255 255 255 / 0.1)",
	},
	color: {
		base: "rgb(0 0 0 / 0.5)",
		_dark: "rgb(255 255 255 / 0.5)",
	},
	display: "flex",
	alignItems: "center",
	justifyContent: "center",
	marginRight: "0.5rem",
});
const smallTextClass = css({
	fontSize: "0.875rem",
	lineHeight: "1.25rem",
});
const relativeClass = css({ position: "relative" });
const postTitleClass = css({
	width: "100%",
	display: "block",
	fontWeight: "700",
	marginBottom: "0.75rem",
	fontSize: { base: "1.875rem", md: "2.25rem" },
	lineHeight: { base: "2.25rem", md: "2.75rem" },
	color: { base: "rgb(0 0 0 / 0.9)", _dark: "rgb(255 255 255 / 0.9)" },
	_before: {
		content: '""',
		width: { md: "0.25rem" },
		height: "1.25rem",
		borderRadius: "0.375rem",
		backgroundColor: "var(--primary)",
		position: "absolute",
		top: "0.75rem",
		left: "-1.125rem",
	},
});
const metadataClass = css({ marginBottom: "1.25rem" });
const metadataDividerClass = css({
	borderColor: "var(--line-divider)",
	borderStyle: "dashed",
	borderBottomWidth: "1px",
	marginBottom: "1.25rem",
});
const postCoverClass = css({
	marginBottom: "2rem",
	borderRadius: "0.75rem",
});
const markdownClass = css({ marginBottom: "1.5rem" });
const licenseClass = css({
	marginBottom: "1.5rem",
	borderRadius: "0.75rem",
});
const postNavigationClass = css({
	display: "flex",
	flexDirection: { base: "column", md: "row" },
	justifyContent: "space-between",
	marginBottom: "1rem",
	gap: "1rem",
	overflow: "hidden",
	width: "100%",
});
const postNavigationLinkClass = css({
	width: "100%",
	fontWeight: "700",
	overflow: "hidden",
	_active: { transform: "scale(0.95)" },
});
const disabledNavigationLinkClass = css({ pointerEvents: "none" });
const navigationCardClass = css({
	borderRadius: "1rem",
	width: "100%",
	height: "3.75rem",
	maxWidth: "100%",
	paddingInline: "1rem",
	display: "flex",
	alignItems: "center",
	gap: "1rem",
});
const previousCardClass = css({ justifyContent: "flex-start !important" });
const nextCardClass = css({ justifyContent: "flex-end !important" });
const navigationIconClass = css({
	fontSize: "2rem",
	color: "var(--primary)",
});
const navigationTitleClass = css({
	overflow: "hidden",
	textOverflow: "ellipsis",
	whiteSpace: "nowrap",
	maxWidth: "calc(100% - 3rem)",
	color: { base: "rgb(0 0 0 / 0.75)", _dark: "rgb(255 255 255 / 0.75)" },
});
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class={postOuterClass}>
        <div id="post-container" class:list={["card-base", postContainerClass]}>
            <!-- word count and reading time -->
            <div class:list={["onload-animation", transitionClass, statsClass]}>
                <div class={statClass}>
                    <div class:list={[transitionClass, statIconClass]}>
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class={smallTextClass}>{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class={statClass}>
                    <div class:list={[transitionClass, statIconClass]}>
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class={smallTextClass}>
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class:list={["onload-animation", relativeClass]}>
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class:list={[transitionClass, postTitleClass]}>
                    {entry.data.title}
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class={metadataClass}
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class={metadataDividerClass}></div>}
            </div>

            <!-- always show cover as long as it has one -->

			{entry.data.image &&
				<ImageWrapper id="post-cover" src={entry.data.image} basePath={imageBasePath} class:list={["banner-container", "onload-animation", postCoverClass]}/>
			}


            <Markdown class={`markdown-content onload-animation ${markdownClass}`}>
                <Content />
            </Markdown>

			{licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class={`license-container onload-animation ${licenseClass}`}></License>}

        </div>
    </div>

    <div class={postNavigationClass}>
        <a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "#"}
           class:list={[postNavigationLinkClass, !entry.data.nextSlug && disabledNavigationLinkClass]}>
            {entry.data.nextSlug && <div class:list={["btn-card", navigationCardClass, previousCardClass]} >
                <Icon name="material-symbols:chevron-left-rounded" class={navigationIconClass} />
                <div class:list={[transitionClass, navigationTitleClass]}>
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "#"}
           class:list={[postNavigationLinkClass, !entry.data.prevSlug && disabledNavigationLinkClass]}>
            {entry.data.prevSlug && <div class:list={["btn-card", navigationCardClass, nextCardClass]}>
                <div class:list={[transitionClass, navigationTitleClass]}>
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class={navigationIconClass} />
            </div>}
        </a>
    </div>

</MainGridLayout>
